   "source": [
    "#ASSIGNMENT 5 - PAN Number Validation Using Regular Expression\n",
    "import re\n",
    "\n",
    "PAN=input(\"Enter PAN number: \")\n",
    "\n",
    "pattern=r\"^[A-Z]{5}[0-9]{4}[A-Z]$\"\n",
    "\n",
    "if re.match(pattern, PAN):\n",
    "    print(\"Valid PAN Number\")\n",
    "else:\n",
    "    print(\"Invalid PAN Number\")"
   ]
  }
